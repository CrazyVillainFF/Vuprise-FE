# Local Development
VITE_API_URL=http://localhost:5000/api

# Production (e.g. Vercel deployment pointing to Render backend)
# Set VITE_API_URL to your deployed API host, for example https://your-api-service.onrender.com/api

# Canonical site origin used for the sitemap, robots.txt, canonical links, and
# Open Graph URLs. Falls back to https://nexora-lac-three.vercel.app when unset.
VITE_SITE_URL=

# Optional GA4 measurement ID (e.g. G-XXXXXXXXXX). Analytics loads only after a
# visitor accepts it in the privacy notice. Leave empty to keep analytics off.
VITE_GA4_MEASUREMENT_ID=
