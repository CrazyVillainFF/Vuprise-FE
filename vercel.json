{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/post/:path*",
      "destination": "/index"
    },
    {
      "source": "/profile/:path*",
      "destination": "/index"
    },
    {
      "source": "/groups/:path*",
      "destination": "/index"
    }
  ]
}
